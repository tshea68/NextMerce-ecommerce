 CREATE OR REPLACE FUNCTION public.rebuild_offers_from_ebay_items_current(p_seller text DEFAULT NULL::text, p_marketplace text DEFAULT 'ebay'::text, p_only_active boolean DEFAULT true)+
  RETURNS bigint                                                                                                                                                                        +
  LANGUAGE plpgsql                                                                                                                                                                      +
 AS $function$\r                                                                                                                                                                        +
 declare\r                                                                                                                                                                              +
   v_rows bigint;\r                                                                                                                                                                     +
 begin\r                                                                                                                                                                                +
   create temporary table tmp_offers_net on commit drop as\r                                                                                                                            +
   with src as (\r                                                                                                                                                                      +
     select\r                                                                                                                                                                           +
       e.*,\r                                                                                                                                                                           +
       nullif(regexp_replace(coalesce(e.item_id, ''), '[^0-9]', '', 'g'), '')::numeric as listing_id_num\r                                                                              +
     from public.ebay_items_current e\r                                                                                                                                                 +
     where (p_seller is null or e.seller = p_seller)\r                                                                                                                                  +
       and (not p_only_active or e.is_active is true)\r                                                                                                                                 +
       and coalesce(e.mpn_norm, '') <> ''\r                                                                                                                                             +
       and e.price_value is not null\r                                                                                                                                                  +
   ),\r                                                                                                                                                                                 +
   by_seller as (\r                                                                                                                                                                     +
     select\r                                                                                                                                                                           +
       mpn_norm,\r                                                                                                                                                                      +
       seller,\r                                                                                                                                                                        +
       count(*)::int as seller_ct,\r                                                                                                                                                    +
       min(first_seen_at) as seller_first_seen\r                                                                                                                                        +
     from src\r                                                                                                                                                                         +
     group by mpn_norm, seller\r                                                                                                                                                        +
   ),\r                                                                                                                                                                                 +
   agg as (\r                                                                                                                                                                           +
     select\r                                                                                                                                                                           +
       mpn_norm,\r                                                                                                                                                                      +
       min(seller_first_seen) as created_at,\r                                                                                                                                          +
       sum(seller_ct)::int as inventory_total,\r                                                                                                                                        +
       jsonb_object_agg(seller, seller_ct) as inventory_sellers\r                                                                                                                       +
     from by_seller\r                                                                                                                                                                   +
     group by mpn_norm\r                                                                                                                                                                +
   ),\r                                                                                                                                                                                 +
   pick as (\r                                                                                                                                                                          +
     select distinct on (mpn_norm)\r                                                                                                                                                    +
       mpn_norm,\r                                                                                                                                                                      +
       listing_id_num,\r                                                                                                                                                                +
       price_value,\r                                                                                                                                                                   +
       coalesce(mpn_raw, mpn_norm) as mpn,\r                                                                                                                                            +
       url,\r                                                                                                                                                                           +
       title,\r                                                                                                                                                                         +
       srp_image,\r                                                                                                                                                                     +
       brand,\r                                                                                                                                                                         +
       appliance_type,\r                                                                                                                                                                +
       part_type\r                                                                                                                                                                      +
     from src\r                                                                                                                                                                         +
     order by mpn_norm, price_value asc nulls last, last_seen_at desc nulls last\r                                                                                                      +
   ),\r                                                                                                                                                                                 +
   brands as (\r                                                                                                                                                                        +
     select\r                                                                                                                                                                           +
       mpn_norm,\r                                                                                                                                                                      +
       json_agg(distinct brand) filter (where brand is not null and brand <> '') as brands_all\r                                                                                        +
     from src\r                                                                                                                                                                         +
     group by mpn_norm\r                                                                                                                                                                +
   ),\r                                                                                                                                                                                 +
   parts_one as (\r                                                                                                                                                                     +
     select\r                                                                                                                                                                           +
       p.mpn_normalized,\r                                                                                                                                                              +
       max(p.compatible_brands) as compatible_brands\r                                                                                                                                  +
     from public.parts p\r                                                                                                                                                              +
     join (\r                                                                                                                                                                           +
       select distinct mpn_norm\r                                                                                                                                                       +
       from src\r                                                                                                                                                                       +
     ) s\r                                                                                                                                                                              +
       on s.mpn_norm = p.mpn_normalized\r                                                                                                                                               +
     where p.mpn_normalized is not null\r                                                                                                                                               +
     group by p.mpn_normalized\r                                                                                                                                                        +
   )\r                                                                                                                                                                                  +
   select\r                                                                                                                                                                             +
     a.created_at,\r                                                                                                                                                                    +
     p.listing_id_num as listing_id,\r                                                                                                                                                  +
     p.price_value as price,\r                                                                                                                                                          +
     p.mpn,\r                                                                                                                                                                           +
     p.url as ebay_url,\r                                                                                                                                                               +
     p.title,\r                                                                                                                                                                         +
     p.srp_image as image_url,\r                                                                                                                                                        +
     p.brand,\r                                                                                                                                                                         +
     b.brands_all,\r                                                                                                                                                                    +
     p.appliance_type,\r                                                                                                                                                                +
     p.part_type,\r                                                                                                                                                                     +
     pp.compatible_brands,\r                                                                                                                                                            +
     null::json as compatible_models,\r                                                                                                                                                 +
     null::json as all_numbers,\r                                                                                                                                                       +
     p_marketplace as marketplace,\r                                                                                                                                                    +
     null::text as feed_title,\r                                                                                                                                                        +
     a.inventory_total,\r                                                                                                                                                               +
     a.inventory_sellers,\r                                                                                                                                                             +
     a.mpn_norm\r                                                                                                                                                                       +
   from agg a\r                                                                                                                                                                         +
   join pick p using (mpn_norm)\r                                                                                                                                                       +
   left join brands b using (mpn_norm)\r                                                                                                                                                +
   left join parts_one pp on pp.mpn_normalized = a.mpn_norm;\r                                                                                                                          +
 \r                                                                                                                                                                                     +
   delete from public.offers\r                                                                                                                                                          +
   where marketplace = p_marketplace;\r                                                                                                                                                 +
 \r                                                                                                                                                                                     +
   insert into public.offers (\r                                                                                                                                                        +
     created_at,\r                                                                                                                                                                      +
     listing_id,\r                                                                                                                                                                      +
     price,\r                                                                                                                                                                           +
     mpn,\r                                                                                                                                                                             +
     ebay_url,\r                                                                                                                                                                        +
     title,\r                                                                                                                                                                           +
     image_url,\r                                                                                                                                                                       +
     brand,\r                                                                                                                                                                           +
     brands_all,\r                                                                                                                                                                      +
     appliance_type,\r                                                                                                                                                                  +
     part_type,\r                                                                                                                                                                       +
     compatible_brands,\r                                                                                                                                                               +
     compatible_models,\r                                                                                                                                                               +
     all_numbers,\r                                                                                                                                                                     +
     marketplace,\r                                                                                                                                                                     +
     feed_title,\r                                                                                                                                                                      +
     inventory_total,\r                                                                                                                                                                 +
     inventory_sellers,\r                                                                                                                                                               +
     mpn_norm\r                                                                                                                                                                         +
   )\r                                                                                                                                                                                  +
   select\r                                                                                                                                                                             +
     created_at,\r                                                                                                                                                                      +
     listing_id,\r                                                                                                                                                                      +
     price,\r                                                                                                                                                                           +
     mpn,\r                                                                                                                                                                             +
     ebay_url,\r                                                                                                                                                                        +
     title,\r                                                                                                                                                                           +
     image_url,\r                                                                                                                                                                       +
     brand,\r                                                                                                                                                                           +
     brands_all,\r                                                                                                                                                                      +
     appliance_type,\r                                                                                                                                                                  +
     part_type,\r                                                                                                                                                                       +
     compatible_brands,\r                                                                                                                                                               +
     compatible_models,\r                                                                                                                                                               +
     all_numbers,\r                                                                                                                                                                     +
     marketplace,\r                                                                                                                                                                     +
     feed_title,\r                                                                                                                                                                      +
     inventory_total,\r                                                                                                                                                                 +
     inventory_sellers,\r                                                                                                                                                               +
     mpn_norm\r                                                                                                                                                                         +
   from tmp_offers_net;\r                                                                                                                                                               +
 \r                                                                                                                                                                                     +
   get diagnostics v_rows = row_count;\r                                                                                                                                                +
   return v_rows;\r                                                                                                                                                                     +
 end;\r                                                                                                                                                                                 +
 $function$                                                                                                                                                                             +
 
